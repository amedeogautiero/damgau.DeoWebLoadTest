<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>LoadTest.Agent</RootNamespace>
    <!-- eseguibile dell'agente: `loadtest-agent` (leggero, senza ASP.NET Core) -->
    <AssemblyName>loadtest-agent</AssemblyName>
    <!-- niente dipendenza da ICU: su Linux minimali e Raspberry l'assenza di libicu fa fallire l'avvio -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <!-- publish per RID (dotnet publish -r <rid>): self-contained, file singolo, compresso. Niente trimming (reflection, YAML, plugin). -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <!-- versioni scelte a memoria (rete non disponibile quando scritto): da verificare al primo restore -->
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.0" />
    <PackageReference Include="Grpc.Net.Client" Version="2.71.0" />
    <ProjectReference Include="..\LoadTest.Engine\LoadTest.Engine.csproj" />
    <ProjectReference Include="..\LoadTest.Plugins\LoadTest.Plugins.csproj" />
    <ProjectReference Include="..\LoadTest.Protocol\LoadTest.Protocol.csproj" />
  </ItemGroup>
</Project>
