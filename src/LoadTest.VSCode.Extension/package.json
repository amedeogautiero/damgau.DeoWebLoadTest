{
  "name": "deoloadtest",
  "displayName": "DeoLoadTest",
  "description": "Web load testing tools for Visual Studio Code.",
  "version": "0.1.0",
  "publisher": "damgau",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:deoloadtest.showWelcome",
    "onCommand:deoloadtest.startHost",
    "onCommand:deoloadtest.stopHost",
    "onCommand:deoloadtest.runLoadTest",
    "onCommand:deoloadtest.runWebTest",
    "onCommand:deoloadtest.debugWebTest",
    "onCommand:deoloadtest.compileScript",
    "onCommand:deoloadtest.importHar",
    "onCommand:deoloadtest.focusRequestExplorer",
    "onCommand:deoloadtest.showTimingInspector",
    "onCommand:deoloadtest.clearRequestExplorer",
    "onCommand:deoloadtest.stopWebTest",
    "onCommand:deoloadtest.showDebugPanel",
    "onCommand:deoloadtest.showVerticalDebugPanel",
    "onCommand:deoloadtest.compileWebTest",
    "onCommand:deoloadtest.showDeoLoadTestView",
    "onView:deoloadtest.mainView"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "deoloadtest.showWelcome",
        "title": "DeoLoadTest: Show Welcome"
      },
      {
        "command": "deoloadtest.startHost",
        "title": "DeoLoadTest: Start Host"
      },
      {
        "command": "deoloadtest.stopHost",
        "title": "DeoLoadTest: Stop Host"
      },
      {
        "command": "deoloadtest.runLoadTest",
        "title": "DeoLoadTest: Run Load Test"
      },
      {
        "command": "deoloadtest.runWebTest",
        "title": "DeoLoadTest: Run WebTest",
        "icon": "$(play)"
      },
      {
        "command": "deoloadtest.debugWebTest",
        "title": "DeoLoadTest: Debug WebTest",
        "icon": "$(debug)"
      },
      {
        "command": "deoloadtest.compileWebTest",
        "title": "DeoLoadTest: Compile WebTest",
        "icon": "$(file-code)"
      },
      {
        "command": "deoloadtest.compileScript",
        "title": "DeoLoadTest: Compile C# Script",
        "icon": "$(symbol-method)"
      },
      {
        "command": "deoloadtest.importHar",
        "title": "DeoLoadTest: Import HAR"
      },
      {
        "command": "deoloadtest.focusRequestExplorer",
        "title": "DeoLoadTest: Focus Request Explorer"
      },
      {
        "command": "deoloadtest.showTimingInspector",
        "title": "DeoLoadTest: Show Timing Inspector"
      },
      {
        "command": "deoloadtest.clearRequestExplorer",
        "title": "DeoLoadTest: Clear Requests",
        "icon": "$(trash)"
      },
      {
        "command": "deoloadtest.stopWebTest",
        "title": "DeoLoadTest: Stop WebTest",
        "icon": "$(debug-stop)"
      },
      {
        "command": "deoloadtest.showDebugPanel",
        "title": "DeoLoadTest: Show Debug Panel",
        "icon": "$(debug)"
      },
      {
        "command": "deoloadtest.showVerticalDebugPanel",
        "title": "DeoLoadTest: Show Panel",
        "icon": "$(layout-sidebar-right)"
      },
      {
        "command": "deoloadtest.showDeoLoadTestView",
        "title": "DeoLoadTest: Open Sidebar",
        "icon": "$(layout-sidebar-left)"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "deoloadtest.requestExplorer",
          "name": "DeoLoadTest - Request Explorer",
          "when": "true"
        }
      ],
      "deoloadtest": [
        {
          "id": "deoloadtest.mainView",
          "name": "DeoLoadTest",
          "type": "webview"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "deoloadtest.requestExplorer",
        "contents": "Run a WebTest to inspect its HTTP requests.\n[Run WebTest](command:deoloadtest.runWebTest)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "deoloadtest.runWebTest",
          "when": "view == deoloadtest.requestExplorer && !deoloadtest.webTestRunning",
          "group": "navigation@1"
        },
        {
          "command": "deoloadtest.stopWebTest",
          "when": "view == deoloadtest.requestExplorer && deoloadtest.webTestRunning",
          "group": "navigation@2"
        },
        {
          "command": "deoloadtest.clearRequestExplorer",
          "when": "view == deoloadtest.requestExplorer",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "deoloadtest.runWebTest",
        "key": "f5",
        "when": "editorTextFocus && resourceExtname == .csx && !deoloadtest.webTestRunning"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "deoloadtest",
          "title": "DeoLoadTest",
          "icon": "resources/deoloadtest-activity.svg"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "yaml": "^2.7.0"
  },
  "extensionDependencies": [
    "ms-dotnettools.csharp"
  ]
}
