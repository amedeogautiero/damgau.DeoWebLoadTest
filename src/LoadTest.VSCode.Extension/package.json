{
  "name": "deoloadtest",
  "displayName": "DeoLoadTest",
  "description": "Web load testing tools for Visual Studio Code.",
  "version": "0.1.0",
  "publisher": "damgau",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:deoloadtest.showWelcome",
    "onCommand:deoloadtest.startHost",
    "onCommand:deoloadtest.stopHost",
    "onCommand:deoloadtest.runLoadTest"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "deoloadtest.showWelcome",
        "title": "DeoLoadTest: Show Welcome"
      },
      {
        "command": "deoloadtest.startHost",
        "title": "DeoLoadTest: Start Host"
      },
      {
        "command": "deoloadtest.stopHost",
        "title": "DeoLoadTest: Stop Host"
      },
      {
        "command": "deoloadtest.runLoadTest",
        "title": "DeoLoadTest: Run Load Test"
      }
    ],
    "yamlValidation": [
      {
        "fileMatch": "*.webtest.yaml",
        "url": "./schemas/webtest.schema.json"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.7.2"
  },
  "extensionDependencies": [
    "redhat.vscode-yaml"
  ]
}
