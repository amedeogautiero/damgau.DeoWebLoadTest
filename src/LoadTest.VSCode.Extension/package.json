{
  "name": "deoloadtest",
  "displayName": "DeoLoadTest",
  "description": "Web load testing tools for Visual Studio Code.",
  "version": "0.1.0",
  "publisher": "damgau",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:deoloadtest.showWelcome",
    "onCommand:deoloadtest.startHost",
    "onCommand:deoloadtest.stopHost",
    "onCommand:deoloadtest.runLoadTest",
    "onCommand:deoloadtest.runWebTest",
    "onCommand:deoloadtest.importHar",
    "onCommand:deoloadtest.focusRequestExplorer",
    "onCommand:deoloadtest.showTimingInspector",
    "onCommand:deoloadtest.clearRequestExplorer",
    "onCommand:deoloadtest.stopWebTest"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "deoloadtest.showWelcome",
        "title": "DeoLoadTest: Show Welcome"
      },
      {
        "command": "deoloadtest.startHost",
        "title": "DeoLoadTest: Start Host"
      },
      {
        "command": "deoloadtest.stopHost",
        "title": "DeoLoadTest: Stop Host"
      },
      {
        "command": "deoloadtest.runLoadTest",
        "title": "DeoLoadTest: Run Load Test"
      },
      {
        "command": "deoloadtest.runWebTest",
        "title": "DeoLoadTest: Run WebTest"
      },
      {
        "command": "deoloadtest.importHar",
        "title": "DeoLoadTest: Import HAR"
      },
      {
        "command": "deoloadtest.focusRequestExplorer",
        "title": "DeoLoadTest: Focus Request Explorer"
      },
      {
        "command": "deoloadtest.showTimingInspector",
        "title": "DeoLoadTest: Show Timing Inspector"
      },
      {
        "command": "deoloadtest.clearRequestExplorer",
        "title": "DeoLoadTest: Clear Requests",
        "icon": "$(trash)"
      },
      {
        "command": "deoloadtest.stopWebTest",
        "title": "DeoLoadTest: Stop WebTest",
        "icon": "$(debug-stop)"
      },
      {
        "command": "deoloadtest.runWebTest",
        "title": "DeoLoadTest: Run WebTest",
        "icon": "$(play)"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "deoloadtest.requestExplorer",
          "name": "DeoLoadTest - Request Explorer",
          "when": "true"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "deoloadtest.requestExplorer",
        "contents": "Run a WebTest to inspect its HTTP requests.\n[Run WebTest](command:deoloadtest.runWebTest)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "deoloadtest.runWebTest",
          "when": "view == deoloadtest.requestExplorer && !deoloadtest.webTestRunning",
          "group": "navigation@1"
        },
        {
          "command": "deoloadtest.stopWebTest",
          "when": "view == deoloadtest.requestExplorer && deoloadtest.webTestRunning",
          "group": "navigation@2"
        },
        {
          "command": "deoloadtest.clearRequestExplorer",
          "when": "view == deoloadtest.requestExplorer",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "yaml": "^2.7.0"
  }
}
