{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DeoLoadTest WebTest",
  "description": "Schema per i file *.webtest.yaml supportati da WebTestLoader (formato v1.x).",
  "type": "object",
  "required": [
    "version"
  ],
  "properties": {
    "version": {
      "type": [
        "integer",
        "string"
      ],
      "pattern": "^1(\\.|$)"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "baseUrl": {
      "type": "string"
    },
    "defaults": {
      "$ref": "#/definitions/defaults"
    },
    "context": {
      "$ref": "#/definitions/stringMap"
    },
    "data": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/dataSource"
      }
    },
    "credentials": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/credential"
      }
    },
    "clientCertificate": {
      "$ref": "#/definitions/clientCertificate"
    },
    "proxy": {
      "$ref": "#/definitions/proxy"
    },
    "plugins": {
      "type": "object",
      "properties": {
        "webTest": {
          "$ref": "#/definitions/pluginList"
        },
        "request": {
          "$ref": "#/definitions/pluginList"
        }
      },
      "additionalProperties": false
    },
    "steps": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/step"
      }
    }
  },
  "definitions": {
    "stringMap": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "integer",
          "boolean",
          "null"
        ]
      }
    },
    "defaults": {
      "type": "object",
      "properties": {
        "timeoutSec": {
          "type": "integer",
          "minimum": 1
        },
        "followRedirects": {
          "type": "boolean"
        },
        "httpVersion": {
          "type": "string",
          "enum": [
            "1.0",
            "1.1",
            "2"
          ]
        },
        "encoding": {
          "type": "string"
        },
        "parseDependentRequests": {
          "type": "boolean"
        },
        "cache": {
          "type": "string",
          "enum": [
            "simulated",
            "none"
          ]
        },
        "headers": {
          "$ref": "#/definitions/headerMap"
        }
      },
      "additionalProperties": false
    },
    "dataSource": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "csv",
            "xml",
            "database",
            "excel"
          ]
        },
        "path": {
          "type": "string"
        },
        "access": {
          "type": "string",
          "enum": [
            "sequential",
            "random",
            "unique"
          ]
        },
        "database": {
          "type": "object",
          "properties": {
            "provider": {
              "type": "string",
              "enum": [
                "sqlite",
                "sqlserver",
                "postgres"
              ]
            },
            "connection": {
              "type": "string"
            },
            "query": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "credential": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "basic",
            "ntlm",
            "negotiate"
          ]
        },
        "user": {
          "type": "string"
        },
        "password": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "clientCertificate": {
      "type": "object",
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "password": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "proxy": {
      "type": "object",
      "required": [
        "url"
      ],
      "properties": {
        "url": {
          "type": "string"
        },
        "bypass": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "pluginList": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "params": {
            "$ref": "#/definitions/stringMap"
          }
        },
        "additionalProperties": false
      }
    },
    "ruleLevel": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "extractRule": {
      "type": "object",
      "required": [
        "name",
        "type"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "enum": [
            "regex",
            "text",
            "attribute",
            "hidden",
            "formField",
            "header",
            "custom"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "level": {
          "$ref": "#/definitions/ruleLevel"
        },
        "pattern": {
          "type": "string"
        },
        "group": {
          "type": [
            "integer",
            "string"
          ]
        },
        "ignoreCase": {
          "type": [
            "boolean",
            "string"
          ]
        },
        "start": {
          "type": "string"
        },
        "end": {
          "type": "string"
        },
        "tag": {
          "type": "string"
        },
        "attribute": {
          "type": "string"
        },
        "matchAttribute": {
          "type": "string"
        },
        "matchValue": {
          "type": "string"
        },
        "index": {
          "type": [
            "integer",
            "string"
          ]
        },
        "field": {
          "type": "string"
        },
        "header": {
          "type": "string"
        },
        "rule": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "validateRule": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "status",
            "textContains",
            "maxTimeMs",
            "responseUrl",
            "formField",
            "tagRequired",
            "attributeRequired",
            "custom"
          ]
        },
        "level": {
          "$ref": "#/definitions/ruleLevel"
        },
        "required": {
          "type": "boolean"
        },
        "expected": {
          "type": [
            "integer",
            "string"
          ]
        },
        "value": {
          "type": [
            "string",
            "number",
            "integer"
          ]
        },
        "ignoreCase": {
          "type": [
            "boolean",
            "string"
          ]
        },
        "ignoreQuery": {
          "type": [
            "boolean",
            "string"
          ]
        },
        "name": {
          "type": "string"
        },
        "tag": {
          "type": "string"
        },
        "minOccurrences": {
          "type": [
            "integer",
            "string"
          ]
        },
        "attribute": {
          "type": "string"
        },
        "rule": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "body": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "form"
          ],
          "properties": {
            "form": {
              "$ref": "#/definitions/stringMap"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "raw"
          ],
          "properties": {
            "raw": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "json"
          ],
          "properties": {
            "json": {}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "xml"
          ],
          "properties": {
            "xml": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "file"
          ],
          "properties": {
            "file": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "multipart"
          ],
          "properties": {
            "multipart": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "name"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "value": {
                    "type": "string"
                  },
                  "file": {
                    "type": "string"
                  },
                  "fileName": {
                    "type": "string"
                  },
                  "contentType": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "requestStep": {
      "type": "object",
      "required": [
        "request"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "request": {
          "type": "object",
          "required": [
            "url"
          ],
          "properties": {
            "method": {
              "type": "string",
              "default": "GET"
            },
            "url": {
              "type": "string"
            },
            "headers": {
              "$ref": "#/definitions/headerMap"
            },
            "body": {
              "$ref": "#/definitions/body"
            },
            "dependentRequests": {
              "type": "string",
              "enum": [
                "auto",
                "none"
              ]
            }
          },
          "additionalProperties": false
        },
        "thinkTimeMs": {
          "type": "integer",
          "minimum": 0
        },
        "expectedStatus": {
          "type": "integer"
        },
        "extract": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/extractRule"
          }
        },
        "validate": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/validateRule"
          }
        }
      },
      "title": "DeoLoadTest Request",
      "description": "Singola richiesta HTTP.",
      "additionalProperties": false
    },
    "step": {
      "defaultSnippets": [
        {
          "label": "Request",
          "description": "HTTP request",
          "body": "- name: example\n  request:\n    method: GET\n    url: https://example.com/"
        },
        {
          "label": "Transaction",
          "description": "Group steps in a transaction",
          "body": "- transaction: example\n  steps:\n    - name: request\n      request:\n        method: GET\n        url: https://example.com/"
        },
        {
          "label": "If",
          "description": "Conditional execution",
          "body": "- if: ${condition}\n  then:\n    - name: request\n      request:\n        method: GET\n        url: https://example.com/"
        },
        {
          "label": "Loop",
          "description": "Repeat a group of steps",
          "body": "- loop:\n    for: 3\n  steps:\n    - name: request\n      request:\n        method: GET\n        url: https://example.com/"
        },
        {
          "label": "Call",
          "description": "Call another WebTest",
          "body": "- call: path/to/another.webtest.yaml"
        },
        {
          "label": "Code",
          "description": "Execute custom code",
          "body": "- code: // custom code"
        }
      ],
      "oneOf": [
        {
          "$ref": "#/definitions/requestStep"
        },
        {
          "type": "object",
          "required": [
            "transaction",
            "steps"
          ],
          "properties": {
            "transaction": {
              "type": "string"
            },
            "steps": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/step"
              }
            }
          },
          "title": "DeoLoadTest Transaction",
          "description": "Raggruppa più step in una transazione.",
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "if",
            "then"
          ],
          "properties": {
            "if": {
              "type": "string"
            },
            "then": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/step"
              }
            },
            "else": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/step"
              }
            }
          },
          "title": "DeoLoadTest If",
          "description": "Esegue gli step in then o else in base a una condizione.",
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "loop",
            "steps"
          ],
          "properties": {
            "loop": {
              "type": "object",
              "required": [
                "for"
              ],
              "properties": {
                "for": {
                  "type": [
                    "integer",
                    "string"
                  ]
                }
              },
              "additionalProperties": false
            },
            "steps": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/step"
              }
            }
          },
          "title": "DeoLoadTest Loop",
          "description": "Ripete un gruppo di step.",
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "call"
          ],
          "properties": {
            "call": {
              "type": "string"
            },
            "params": {
              "$ref": "#/definitions/stringMap"
            }
          },
          "title": "DeoLoadTest Call",
          "description": "Richiama un altro file WebTest.",
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "code"
          ],
          "properties": {
            "code": {
              "type": "string"
            }
          },
          "title": "DeoLoadTest Code",
          "description": "Esegue codice personalizzato.",
          "additionalProperties": false
        }
      ]
    },
    "headerMap": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
